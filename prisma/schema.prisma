generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String      @id @default(cuid())
  clerkId     String      @unique
  username    String?
  ship        Ship?
  currentTurn Int         @default(1)
  createdAt   DateTime    @default(now())
}

model Sector {
  id           String  @id @default(cuid())
  abbreviation String  @unique
  name         String
  gridX        Int
  gridY        Int
  milieu       String  @default("M1105")
  worlds       World[]
}

model World {
  id             String        @id @default(cuid())
  hex            String
  hexX           Int
  hexY           Int
  name           String
  sectorId       String
  sector         Sector        @relation(fields: [sectorId], references: [id])
  subsector      String
  starport       String
  size           String
  atmosphere     String
  hydrographics  String
  population     String
  government     String
  lawLevel       String
  techLevel      String
  uwpRaw         String
  remarks        String[]
  travelZone     String?
  allegiance     String?
  stellar        String[]
  gasGiants      Int           @default(0)
  belts          Int           @default(0)
  worldsInSystem Int           @default(0)
  systemCaches   WorldSystemCache[]

  @@unique([sectorId, hex])
}

model WorldSystemCache {
  id               String   @id @default(cuid())
  worldId          String
  world            World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  generatorVersion Int
  data             Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([worldId, generatorVersion])
  @@index([generatorVersion])
}

model Ship {
  id                  String          @id @default(cuid())
  name                String
  type                String
  jumpRating          Int
  isMortgaged         Boolean         @default(true)
  mortgagePaid        Int             @default(0)
  status              String          @default("docked")
  sheet               Json?
  currentLocation     String?
  destinationLocation String?
  jumpArrivesTurn     Int?
  userId              String?         @unique
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  crew                ShipCrew[]
  cargo               CargoLot[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model ShipCrew {
  id              String     @id @default(cuid())
  shipId          String
  ship            Ship       @relation(fields: [shipId], references: [id], onDelete: Cascade)
  characterId     String?    @unique
  npcName         String?
  role            String
  isOwnerOperator Boolean    @default(false)
  monthlySalary   Int        @default(0)
  keySkillName    String?
  keySkillLevel   Int        @default(0)
  unpaidTurns     Int        @default(0)
}

model CargoLot {
  id             String   @id @default(cuid())
  shipId         String
  ship           Ship     @relation(fields: [shipId], references: [id], onDelete: Cascade)
  commodity      String
  tons           Int
  purchasePrice  Int
  originLocation String?
  acquiredAt     DateTime @default(now())
}
