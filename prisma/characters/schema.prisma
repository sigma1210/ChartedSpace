generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/character-prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id              String           @id @default(cuid())
  userId          String?
  kind            String           @default("player")
  name            String
  strength        Int
  dexterity       Int
  endurance       Int
  intelligence    Int
  education       Int
  socialStanding  Int
  credits         Int              @default(0)
  sheet           Json?
  currentLocation String?
  currentShipId   String?
  currentShipRole String?
  skills          CharacterSkill[]
  locationLog     LocationLog[]
  relationshipsFrom CharacterRelationship[] @relation("RelationshipFrom")
  relationshipsTo   CharacterRelationship[] @relation("RelationshipTo")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([kind])
  @@index([currentLocation])
  @@index([currentShipId])
}

model CharacterSkill {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  level       Int

  @@index([characterId])
  @@unique([characterId, name])
}

model LocationLog {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  location    String
  arrivedAt   DateTime  @default(now())

  @@index([characterId])
  @@index([location])
}

model CharacterRelationship {
  id              String    @id @default(cuid())
  fromCharacterId String
  toCharacterId   String
  fromCharacter   Character @relation("RelationshipFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter     Character @relation("RelationshipTo", fields: [toCharacterId], references: [id], onDelete: Cascade)
  type            String
  attitude        Int
  notes           String?
  source          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([fromCharacterId])
  @@index([toCharacterId])
  @@index([type])
}
